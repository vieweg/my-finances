# Settings for docker compose. Everything is optional; copy to .env to change a value.

# Where the app is published on the host. Use 127.0.0.1:8080 behind a reverse proxy
# on the same machine, so it is only reachable through the proxy.
APP_PORT=8080
# The URL people open (used in password reset emails)
APP_URL=http://localhost:8080

# The first account, created on the first start only (defaults: admin / please_change_me).
# Remove ADMIN_PASSWORD from this file once you have logged in.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_EMAIL=admin@example.com

# Database password, read when the database is first created: set it before the first start.
# (The database is not exposed outside the compose network.)
DB_PASSWORD=change_me

# Set to true when the app is served over HTTPS (e.g. behind a TLS reverse proxy)
COOKIE_SECURE=false

# Number of proxies in front of the API: 1 is the bundled web container.
# Use 2 when you add your own reverse proxy in front of it.
TRUST_PROXY=1

# IANA time zone used to cut days/weeks/months in balance charts
APP_TIMEZONE=UTC

# JWT secrets are generated on first start and stored in the api-data volume.
# Set them here only if you want to manage them yourself.
# JWT_SECRET=
# JWT_SECRET_REFRESH=
# JWT_RESET_SECRET=

# Password reset and job log emails via Brevo (optional)
# BREVO_API_KEY=
# BREVO_FROM_NAME=
# BREVO_FROM_EMAIL=
# SEND_LOGS=false
