PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# when emails service available sends cron job logs per email
SEND_LOGS=false

JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=15m # 1d, 3600, 30m

JWT_SECRET_REFRESH=your_jwt_refresh_secret
JWT_EXPIRATION_REFRESH=7d # 1d, 3600, 30m

JWT_RESET_SECRET=your_jwt_reset_secret

BREVO_API_KEY=
BREVO_FROM_NAME=
BREVO_FROM_EMAIL=

# IANA time zone used to cut days/weeks/months in the wallet balance series (default UTC)
APP_TIMEZONE=America/Sao_Paulo
