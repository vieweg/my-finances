{
  "name": "controle_caixa_node",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && copyfiles -u 1 \"src/email/**/*.pug\" dist/",
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "nodemon --watch src/**/*.ts --exec ts-node src/server.ts",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:create": "cross-var typeorm-ts-node-commonjs migration:create src/database/migrations/$npm_config_name ",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/index.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/index.ts",
    "cli": "ts-node src/cli.ts",
    "import:legacy": "ts-node src/scripts/importLegacy.ts",
    "backup": "ts-node src/scripts/backup.ts"
  },
  "keywords": [],
  "author": "Rafael Vieweg <rafael@vieweg.dev>",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.18",
    "@types/node-cron": "^3.0.11",
    "@types/pug": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "cross-var": "^1.1.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.15.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@getbrevo/brevo": "^2.2.0",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.2.0",
    "joi": "^17.13.3",
    "joi-to-swagger": "^6.2.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.1",
    "node-cron": "^4.2.1",
    "pug": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.24",
    "uuid": "^11.1.0"
  }
}
